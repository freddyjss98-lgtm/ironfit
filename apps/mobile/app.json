{
  "expo": {
    "name": "Iron Fit Club",
    "slug": "ironfit",
    "owner": "freddyjss-organization",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ironfit",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "org.ironfitclub.app"
    },
    "android": {
      "package": "org.ironfitclub.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Iron Fit usa tus fotos para tu foto de perfil, los comprobantes de pago y lo que compartes en la comunidad.",
          "cameraPermission": "Iron Fit usa la cámara para tu foto de perfil, los comprobantes de pago y las fotos de tus retos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#e84b1f"
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Iron Fit guarda en tus fotos las tarjetas de tu WOD y de tus actividades para compartirlas.",
          "savePhotosPermission": "Iron Fit guarda en tus fotos las tarjetas de tu WOD y de tus actividades para compartirlas.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Iron Fit usa tu ubicación solo mientras grabas una actividad, para medir la distancia y dibujar tu recorrido.",
          "locationAlwaysAndWhenInUsePermission": "Iron Fit usa tu ubicación solo mientras grabas una actividad, para medir la distancia y dibujar tu recorrido.",
          "locationAlwaysPermission": "Iron Fit usa tu ubicación solo mientras grabas una actividad, para medir la distancia y dibujar tu recorrido.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0142c93a-9a1b-4f0d-91ad-bbb13a18ea3c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0142c93a-9a1b-4f0d-91ad-bbb13a18ea3c"
    }
  }
}
