{
  "name": "ironfit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ironfit/web",
    "build": "npm run build -w @ironfit/web",
    "lint": "npm run lint -w @ironfit/web",
    "mobile": "npm run start -w @ironfit/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
